/** Location types whose coordinates the backend resolves from the location ID. */
export const PICKUP_LOCATION_ID_TYPES = ["Airport", "Hospital", "Guest House"];

export const isPickupIdLocationType = (type) =>
  PICKUP_LOCATION_ID_TYPES.includes(String(type || "").trim());

